<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.luci" name="LuCI" version="1.0.0" provider-name="openwrt.org">
  <requires>
    <import addon="kodi.webapp" version="1.0.0"/>
  </requires>
  <extension point="kodi.webapp" starturl="http://127.0.0.1/cgi-bin/luci/">
    <useragent>Mozilla/5.0 (Linux; aarch64) AppleWebKit/605.1.15 (KHTML, like Gecko) WPE Kodi/22.0</useragent>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">LuCI inside Kodi</summary>
    <description lang="en_GB">Opens the local OpenWrt web interface in Kodi's web view.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/dangowrt/kodi-webapps</source>
    <assets>
      <icon>http://127.0.0.1/luci-static/bootstrap/logo_48.png</icon>
    </assets>
  </extension>
</addon>
